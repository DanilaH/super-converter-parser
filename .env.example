# Utility Research Runner — environment configuration
# All variables are optional; the runner works with sensible defaults.
# Copy to `.env` and adjust as needed. `.env` is gitignored.

# --- Durable outputs (independent from git/Kilo worktrees) ---
# Must be absolute when set. Example: C:\\1Projects\\super-converter-parser-output
RESEARCH_OUTPUT_ROOT=

# --- Research Chrome (controlled over CDP) ---
CDP_URL=http://127.0.0.1:9222
NAVIGATION_TIMEOUT_MS=60000

# --- Ahrefs DR enrichment ---
# Ahrefs API key (v3 public Domain Rating free endpoint).
# Never commit this value. Use a local `.env` file or shell env.
AHREFS_API_KEY=
REQUIRE_AHREFS=false
AHREFS_ENDPOINT=https://api.ahrefs.com/v3/public/domain-rating-free
AHREFS_MIN_DELAY_MS=1000
AHREFS_MAX_DELAY_MS=10000
AHREFS_TIMEOUT_MS=15000

# --- Research market ---
RESEARCH_MARKET=US
GOOGLE_HL=en
GOOGLE_GL=us
TOP_N=10

# --- Keyword Surfer ---
SURFER_WAIT_MS=60000
SURFER_PREFLIGHT_TIMEOUT_MS=60000
SURFER_WIDGET_SELECTOR=.surfer-main-keyword-widget
SURFER_RELATED_WIDGET_SELECTOR=keyword-surfer-sidebar
SURFER_RELATED_MISSING_WIDGET_TIMEOUT_MS=5000

# --- Cache ---
CACHE_DB_PATH=data/cache/cache.sqlite
CACHE_TTL_COMPLETED_MS=604800000
CACHE_TTL_PARTIAL_MS=21600000
CACHE_TTL_FAILED_MS=3600000
CACHE_TTL_RELATED_MS=604800000
CACHE_TTL_RELATED_ERROR_MS=3600000
CACHE_TTL_DOMAIN_OK_MS=2592000000
CACHE_TTL_DOMAIN_NOT_FOUND_MS=2592000000
CACHE_TTL_DOMAIN_ERROR_MS=3600000
# Domain-age enrichment cache (registration date via RDAP + first-seen).
# Row TTL is the minimum of the registration and first-seen TTLs so the
# freshest fact is always refreshed.
CACHE_TTL_RDAP_OK_MS=15552000000
CACHE_TTL_RDAP_NOT_FOUND_MS=2592000000
CACHE_TTL_RDAP_UNSUPPORTED_MS=2592000000
CACHE_TTL_RDAP_ERROR_MS=3600000
CACHE_TTL_FIRST_SEEN_OK_MS=2592000000
CACHE_TTL_FIRST_SEEN_ERROR_MS=3600000
CACHE_TTL_FIRST_SEEN_UNAVAILABLE_MS=86400000

# --- RDAP (registration date) ---
# No API key required: uses the IANA RDAP bootstrap.
RDAP_BOOTSTRAP_BASE=https://data.iana.org/rdap/
RDAP_BOOTSTRAP_FILE=dns.json
RDAP_BOOTSTRAP_TTL_MS=86400000
RDAP_QUERY_TIMEOUT_MS=15000
RDAP_PER_HOST_MIN_DELAY_MS=500
RDAP_MAX_ATTEMPTS=3
RDAP_BASE_DELAY_MS=1000
RDAP_MAX_DELAY_MS=15000

# --- First-seen enrichment ---
# Provider: 'wayback' (default, free, unauthenticated) or blank to disable
# (domains get firstSeenDate=null with status 'unavailable').
FIRST_SEEN_PROVIDER=wayback
FIRST_SEEN_ENDPOINT=https://web.archive.org/cdx/search/cdx
FIRST_SEEN_TIMEOUT_MS=15000
FIRST_SEEN_MIN_DELAY_MS=1000
FIRST_SEEN_MAX_ATTEMPTS=3
FIRST_SEEN_BASE_DELAY_MS=1000
FIRST_SEEN_MAX_DELAY_MS=15000

# --- Retry ---
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=15000

# --- Circuit breaker ---
BREAKER_SURFER_WINDOW=15
BREAKER_SURFER_FAILURES=12
BREAKER_GOOGLE_CONSECUTIVE=10

# --- Expansion ---
EXPANSION_ENABLED=false
EXPANSION_DEPTH=1
EXPANSION_MAX_CANDIDATES=20
EXPANSION_MIN_OVERLAP=0
EXPANSION_MIN_VOLUME=0

# --- Scoring ---
SCORING_DR_VERY_WEAK_MAX=10
SCORING_DR_WEAK_MAX=30
SCORING_DR_STRONG_MIN=60
SCORING_DR_STRONG_MAX=75

# --- CAPTCHA ---
CAPTCHA_DONE_MARKER=C:\tmp\captcha-done.txt
