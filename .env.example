# Utility Research Runner — environment configuration
# All variables are optional; the runner works with sensible defaults.
# Copy to `.env` and adjust as needed. `.env` is gitignored.

# --- Research Chrome (controlled over CDP) ---
# URL of the running Chrome DevTools endpoint. Default: http://127.0.0.1:9222
CDP_URL=

# --- Ahrefs DR enrichment ---
# Ahrefs API key (v3 public Domain Rating free endpoint). When set, DR enrichment is enabled.
# Never commit this value. Use a local `.env` file or shell env.
AHREFS_API_KEY=

# When true, a missing/blank key fails before keyword collection with AHREFS_REQUIRE_CONFIG.
# Default: false
REQUIRE_AHREFS=

# Ahrefs API endpoint override. Default: https://api.ahrefs.com/v3/public/domain-rating-free
AHREFS_ENDPOINT=

# Ahrefs rate-limit backoff bounds in milliseconds.
AHREFS_MIN_DELAY_MS=
AHREFS_MAX_DELAY_MS=
AHREFS_TIMEOUT_MS=

# --- Research market ---
# Surfer market, Google hl/gl. Default: US / en / us
RESEARCH_MARKET=
RESEARCH_GOOGLE_HL=
RESEARCH_GOOGLE_GL=
RESEARCH_TOP_N=

# --- Keyword Surfer ---
# Keyword Surfer widget selectors (rarely need changing).
SURFER_WIDGET_SELECTOR=
SURFER_RELATED_WIDGET_SELECTOR=
SURFER_WAIT_TIMEOUT_MS=

# --- Cache ---
# Cache DB path and TTLs in milliseconds.
CACHE_PATH=
CACHE_TTL_COMPLETED_MS=
CACHE_TTL_PARTIAL_MS=
CACHE_TTL_FAILED_MS=
CACHE_TTL_RELATED_MS=
CACHE_TTL_DOMAIN_OK_MS=
CACHE_TTL_DOMAIN_NOT_FOUND_MS=
CACHE_TTL_DOMAIN_ERROR_MS=

# --- Expansion ---
EXPANSION_ENABLED=
EXPANSION_DEPTH=
EXPANSION_MAX_CANDIDATES_PER_KEYWORD=
EXPANSION_MIN_OVERLAP=
EXPANSION_MIN_VOLUME=

# --- Scoring ---
SCORING_DR_VERY_WEAK_MAX=
SCORING_DR_WEAK_MAX=
SCORING_DR_STRONG_MIN=
SCORING_DR_STRONG_MAX=

# --- CAPTCHA ---
# Marker file to create after solving CAPTCHA in a background run.
CAPTCHA_DONE_MARKER=
