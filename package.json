{
  "name": "super-converter-parser",
  "version": "0.0.1",
  "private": true,
  "description": "Utility Research Runner - local SEO research CLI",
  "type": "module",
  "scripts": {
    "probe": "tsx src/spike.ts",
    "research": "tsx src/cli/research.ts",
    "discovery:full": "tsx src/cli/research.ts --expand",
    "research:append": "tsx src/cli/appendResearch.ts",
    "research:status": "tsx src/cli/researchStatus.ts",
    "research:diff": "tsx src/cli/researchDiff.ts",
    "enrich": "tsx src/cli/enrich.ts",
    "enrich:full": "tsx src/cli/enrich.ts --modules clusters,query_suggestions,domain_age,pages,site_structure",
    "finalize:full": "tsx src/cli/fullFinalize.ts",
    "representatives": "tsx src/cli/representatives.ts",
    "entrant-cohort": "tsx src/cli/entrantCohort.ts",
    "cohort-historical-presence": "tsx src/cli/cohortHistoricalPresence.ts",
    "cohort-history": "tsx src/cli/cohortHistory.ts",
    "traffic-evidence": "tsx src/cli/trafficEvidence.ts",
    "finalist-evidence": "tsx src/cli/finalistEvidence.ts",
    "library:publish": "tsx src/cli/publishLibrary.ts",
    "chrome:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/research-chrome.ps1 -Mode setup",
    "chrome:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/research-chrome.ps1 -Mode start",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^7.0.2",
    "playwright-core": "^1.62.1",
    "tldts": "^7.4.11",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
